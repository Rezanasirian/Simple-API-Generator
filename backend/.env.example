# Internal database (users, API keys, data sources, API definitions, call log).
# Any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pass@host/dbname
DATABASE_URL=sqlite:///./data/app.db

# Signs login tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# First admin account, created when the users table is empty.
# Without ADMIN_PASSWORD a random password is generated and printed to the log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

ALLOW_REGISTRATION=false
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Origins allowed to call the panel API (the Vite dev server by default).
CORS_ORIGINS=["http://localhost:5173"]
